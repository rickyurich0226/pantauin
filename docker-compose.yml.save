services:
  pantau_web:
    build: .
    container_name: pantau_web
    restart: unless-stopped
    environment:
      - NODE_ENV=production
      - DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pantau_postgres:5432/${POSTGRES_DB}
      - NEXTAUTH_URL=${NEXTAUTH_URL}
      - NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
      - CRON_SECRET=${CRON_SECRET}
      - SUPERADMIN_EMAIL=${SUPERADMIN_EMAIL}
      - SUPERADMIN_PASSWORD=${SUPERADMIN_PASSWORD}
      - SMTP_HOST=smtp.gmail.com
      - SMTP_PORT=587
      - SMTP_USER=pantau.inofficial@gmail.com
      - SMTP_PASS=olumes:
      - ./app-secrets.env:/app/.env
      - ./app-secrets.env:/app/.env.local
      - ./data:/app/data
    ports:
      - "127.0.0.1:3001:3001"
    depends_on:
      pantau_postgres:
        condition: service_healthy
    networks:
      - pantau_net

  pantau_postgres:
    image: postgres:16-alpine
    container_name: pantau_postgres
    restart: unless-stopped
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${POSTGRES_DB}
    volumes:
      - pantau_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - pantau_net

volumes:
  pantau_pgdata:

networks:
  pantau_net:
    driver: bridge
