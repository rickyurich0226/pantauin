# Integrasi pihak ketiga — bisa diisi sekarang, atau nanti lewat
# Super Admin → Integrasi setelah aplikasi live (panel akan menulis ulang
# file ini secara otomatis).

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Pantau.in <noreply@pantau.in>"

# --- Midtrans (payment) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Telegram bot (untuk notifikasi & link akun via /start) ---
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Business API ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=

# --- OpenAI (AI semantic matching antara watch query & listing baru) ---
# Kosongkan dulu kalau belum punya — sistem otomatis fallback ke keyword
# matching biar tetap jalan tanpa AI.
OPENAI_API_KEY=
