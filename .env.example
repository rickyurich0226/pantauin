# === Database ===
POSTGRES_USER=pantau_user
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_KUAT
POSTGRES_DB=pantau_db

# === App ===
NEXTAUTH_URL=https://pantau.in
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=GANTI_DENGAN_HASIL_OPENSSL_RAND

# Secret yang dipakai cron di VPS untuk memanggil endpoint /api/cron/*
# Generate dengan: openssl rand -hex 24
CRON_SECRET=GANTI_DENGAN_HASIL_OPENSSL_RAND

# === Akun Super Admin pertama (dipakai sekali saat `npm run db:seed`) ===
SUPERADMIN_EMAIL=owner@pantau.in
SUPERADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_MIN_12_KARAKTER
